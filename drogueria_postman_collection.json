{
  "info": {
    "_postman_id": "drogueria-microservicios-collection",
    "name": "💊 Droguería Microservicios (Vía Gateway :8080)",
    "description": "Colección completa para la arquitectura de Droguería:\n- Gateway (:8080)\n- Auth Service Spring Boot (:8081)\n- Medicamentos Service Node.js (:3001)\n- Ventas Service Node.js (:3002)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔐 1. Auth Service (Spring Boot)",
      "item": [
        {
          "name": "1. Registrar Usuario",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Carlos Gomez\",\n  \"email\": \"carlos@drogueria.com\",\n  \"password\": \"123456\",\n  \"roleId\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "2. Login (Auto-captura Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.data.token);",
                  "    console.log(\"Token guardado en variable de colección:\", jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"carlos@drogueria.com\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "💊 2. Medicamentos Service (Node.js)",
      "item": [
        {
          "name": "1. Crear Medicamento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Acetaminofen 500mg\",\n  \"laboratorio_fabrica\": \"Genfar\",\n  \"fecha_fabricacion\": \"2024-01-15\",\n  \"fecha_vencimiento\": \"2026-12-31\",\n  \"cantidad_stock\": 100,\n  \"valor_unitario\": 1500.00\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/medicamentos",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "medicamentos"]
            }
          }
        },
        {
          "name": "2. Listar Medicamentos (Paginado)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/medicamentos?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "medicamentos"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "3. Obtener Medicamento por ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/medicamentos/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "medicamentos", "1"]
            }
          }
        },
        {
          "name": "4. Actualizar Medicamento",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Acetaminofen Forte 650mg\",\n  \"laboratorio_fabrica\": \"Genfar\",\n  \"fecha_fabricacion\": \"2024-01-15\",\n  \"fecha_vencimiento\": \"2027-01-01\",\n  \"cantidad_stock\": 120,\n  \"valor_unitario\": 2200.00\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/medicamentos/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "medicamentos", "1"]
            }
          }
        },
        {
          "name": "5. Eliminar Medicamento",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/medicamentos/1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "medicamentos", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "🛒 3. Ventas Service (Node.js)",
      "item": [
        {
          "name": "1. Registrar Venta (Descuenta Stock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medicamento_id\": 1,\n  \"cantidad\": 5\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/ventas",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "ventas"]
            }
          }
        },
        {
          "name": "2. Listar Ventas (Paginado)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/ventas?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "ventas"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        }
      ]
    }
  ]
}